{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing. Runs in CI, in the `static` job, and breaks the build below 100. Deliberately narrow \u2014 point it at pure-logic modules only. The shape follows stuffbucket/maximal's stryker.conf.json, with the Vitest runner instead of a command runner because the unit suite is already Vitest. Anything importing `electron` cannot be mutated here: it needs a real Electron runtime, not Node.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/shared/urls.ts",
    "src/renderer/lib/data.ts",
    "src/renderer/lib/theme.ts",
    "src/main/native/approval.ts",
    "src/main/native/grammar.ts",
    "src/main/native/ffmpeg.ts",
    "src/main/native/icons.ts",
    "src/renderer/lib/overlay-keys.ts",
    "src/renderer/lib/resolve-bridge.ts",
    "src/renderer/lib/contrast.ts",
    "src/renderer/lib/account.ts",
    "src/renderer/lib/settings.ts",
    "src/main/native/pty-session.ts",
    "scripts/terminal-package.mjs"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "tempDirName": ".stryker-tmp",
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    "out",
    ".vite",
    "node_modules",
    "dist",
    "reports",
    "test-results",
    "playwright-report",
    "e2e"
  ]
}
