<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI for the Stuffbucket desktop application.

  Adapted from stuffbucket/maximal's build/windows/maximal.wxs, which is the
  last known good Windows installer in this organisation. Four things differ,
  because that one installs a single command-line binary and this installs a
  GUI application:

    1. It harvests a whole directory. A packaged Electron app is hundreds of
       files, not one .exe, so the file list is generated by `wix build`'s
       Files element rather than written by hand.
    2. It adds Start Menu and Desktop shortcuts. The application has a window.
    3. It does NOT put the install directory on PATH. A GUI app does not
       belong there.
    4. It keeps the HKCU marker, which the verify job asserts.

  Everything else is carried over deliberately: WiX 5 syntax, per-user scope
  (no UAC prompt, no admin), MajorUpgrade for clean upgrades, an embedded cab,
  and a taskkill custom action so an upgrade does not hit the "files in use"
  prompt while the running app holds a file lock.

  Built in CI on windows-2022. The commands are in docs/release.md, because an
  XML comment cannot contain a double hyphen and every one of them has a long
  option.

  Ships UNSIGNED. Authenticode is deferred organisation-wide; see
  docs/signing.md.
-->
<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="Stuffbucket"
      Manufacturer="stuffbucket"
      Version="$(var.Version)"
      UpgradeCode="7F3C1A94-6D28-4B5E-9C13-2A8E5D4F1B60"
      Scope="perUser"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation
        Description="Stuffbucket — reference Electron application"
        Manufacturer="stuffbucket" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="!(bindpath.AppDir)\Stuffbucket.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Feature Id="Main" Title="Stuffbucket" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
      <ComponentGroupRef Id="AppMarkers" />
    </Feature>

    <!--
      Stop any running copy before files are touched. taskkill returns 128 when
      nothing matches; Return="ignore" treats that as success. SystemFolder
      resolves to C:\Windows\System32 at run time.
    -->
    <CustomAction
        Id="StopRunningApp"
        Directory="SystemFolder"
        ExeCommand="taskkill.exe /F /IM Stuffbucket.exe /T"
        Execute="immediate"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopRunningApp" Before="InstallValidate" />
    </InstallExecuteSequence>

  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Stuffbucket" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!--
      Harvest the packaged output, so adding a locale or a helper binary needs
      no change here. The AppDir bind path must be ABSOLUTE: WiX resolves a
      relative one against this file's directory, harvests nothing, and only
      warns. `scripts/build-msi.ps1` is what makes it absolute (#86).
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.AppDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppShortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut
            Id="StartMenuStuffbucket"
            Name="Stuffbucket"
            Description="Reference Electron application"
            Target="[INSTALLFOLDER]Stuffbucket.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <!-- A per-user shortcut component needs a registry keypath. -->
        <RegistryValue
            Root="HKCU"
            Key="Software\stuffbucket\Stuffbucket"
            Name="startMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <RemoveFolder Id="RemoveStartMenu" Directory="ProgramMenuFolder" On="uninstall" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
        <Shortcut
            Id="DesktopStuffbucket"
            Name="Stuffbucket"
            Target="[INSTALLFOLDER]Stuffbucket.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\stuffbucket\Stuffbucket"
            Name="desktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppMarkers" Directory="INSTALLFOLDER">
      <!--
        Per-user HKCU keypath that doubles as the "installed" marker the
        windows-msi-verify job asserts. Its own component, so its keypath is
        independent of any file.
      -->
      <Component Id="InstalledMarker" Bitness="always64" Guid="*">
        <RegistryValue
            Root="HKCU"
            Key="Software\stuffbucket\Stuffbucket"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
