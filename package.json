{
  "name": "stuffbucket-electron",
  "productName": "Stuffbucket",
  "version": "0.0.0",
  "description": "Reference Electron application with cross-platform build and release mechanics",
  "license": "MIT",
  "author": "stuffbucket",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuffbucket/electron.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "icons": "node scripts/gen-icons.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "vale --min-severity error README.md AGENTS.md docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.27.0",
    "node-llama-cpp": "^3.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.2.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
