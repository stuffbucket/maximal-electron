{
  "name": "stuffbucket-electron",
  "productName": "Stuffbucket",
  "version": "0.0.1",
  "description": "Reference Electron application with cross-platform build and release mechanics",
  "license": "MIT",
  "author": "stuffbucket",
  "main": ".vite/build/main.js",
  "exports": {
    "./host": {
      "types": "./dist/host/host-window.d.ts",
      "default": "./dist/host/host-window.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./renderer/styles.css": "./dist/renderer/styles.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuffbucket/maximal-electron.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "build:host": "tsc -p tsconfig.host.json",
    "build:renderer": "tsc -p tsconfig.renderer-package.json && node scripts/copy-renderer-css.mjs",
    "build:package": "npm run build:host && npm run build:renderer",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "icons": "node scripts/gen-icons.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:exports": "npm run build:package && node scripts/verify-exports.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record": "node scripts/record.mjs",
    "mutate": "stryker run",
    "compose": "node scripts/compose.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "stills": "node scripts/stills.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "storybook:check": "node scripts/storybook-check.mjs",
    "check:contrast": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.27.0",
    "node-llama-cpp": "^3.19.1",
    "react-resizable-panels": "^4.12.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.2.0",
    "eslint": "^9.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "10.5.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
